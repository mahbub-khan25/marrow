    "Make Home yours: tap Edit to move, resize and change cards, or add new ones.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Home yours: tap Edit to move, resize and change cards, or add new ones."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোম নিজের মতো করুন: কার্ড সরাতে, আকার বদলাতে, বদলাতে বা নতুন যোগ করতে সাজান-এ ট্যাপ করুন।"
          }
        }
      }
    },
    "Markdown, text and web pages": {
      "extractionState": "manual",
      "localizations": {
