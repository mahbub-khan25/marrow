    },
    "Your notes go in %@, as plain Markdown files you can open there too. Marrow can't see anything else in your %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes go in %1$@, as plain Markdown files you can open there too. Marrow can't see anything else in your %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নোট থাকবে %1$@-এ, সাধারণ Markdown ফাইল হিসেবে, যা সেখানেও খোলা যায়। আপনার %2$@-এর আর কিছুই ম্যারো দেখতে পায় না।"
          }
        }
      }
    },
    "Your notes go in iCloud Drive › Marrow › %@. On a Mac, open that folder in Marrow, or sync with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes go in iCloud Drive › Marrow › %1$@. On a Mac, open that folder in Marrow, or sync with it."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নোট থাকবে iCloud Drive › Marrow › %1$@-এ। Mac-এ ম্যারোতে ওই ফোল্ডার খুলুন, অথবা তার সাথে সিঙ্ক করুন।"
          }
        }
      }
    },
    "Your own server (WebDAV)": {
      "extractionState": "manual",
