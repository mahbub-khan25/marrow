    "A vault is the folder your notes live in, as plain Markdown files. The same vault works in Marrow on a computer, and in Obsidian.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vault is the folder your notes live in, as plain Markdown files. The same vault works in Marrow on a computer, and in Obsidian."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট হলো যে ফোল্ডারে আপনার নোট সাধারণ মার্কডাউন ফাইল হিসেবে থাকে। একই ভল্ট কম্পিউটারের ম্যারোতে ও Obsidian-এ কাজ করে।"
          }
        }
      }
