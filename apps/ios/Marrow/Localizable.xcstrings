        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তত ৮ অক্ষর। প্রতিটি ডিভাইসে একই পাসফ্রেজ দিন। এটি ছাড়া সেখানকার নোট পড়া যাবে না।"
          }
