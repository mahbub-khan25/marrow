    "Notes are plain text files you own. Write freely; Marrow keeps everything safe as you type.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes are plain text files you own. Write freely; Marrow keeps everything safe as you type."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোট হলো আপনার নিজের সাধারণ টেক্সট ফাইল। মন খুলে লিখুন; লেখার সাথে সাথে ম্যারো সব নিরাপদে রাখে।"
          }
        }
      }
    },
    "Notes are sealed on this phone with a passphrase; the server can't read them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes are sealed on this phone with a passphrase; the server can't read them."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোট এই ফোনেই পাসফ্রেজ দিয়ে সিল করা হয়; সার্ভার সেগুলো পড়তে পারে না।"
          }
        }
      }
    },
