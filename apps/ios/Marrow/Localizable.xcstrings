        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিখুন: নোট-এ + ট্যাপ করে লিখতে শুরু করুন। সব নিজে থেকেই রাখা হয়।"
          }
        }
      }
    },
