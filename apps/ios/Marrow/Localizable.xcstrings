          }
        }
      }
    },
    "Marrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যারো"
          }
        }
      }
    },
    "Marrow can't take this right now. Open Marrow once, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow can't take this right now. Open Marrow once, then try again."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যারো এখন এটি নিতে পারছে না। একবার ম্যারো খুলে আবার চেষ্টা করুন।"
          }
        }
      }
    },
    "Marrow finds the parts of your notes that match and sends only those to your AI. Each point in the answer links to the note it comes from.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow finds the parts of your notes that match and sends only those to your AI. Each point in the answer links to the note it comes from."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যারো আপনার নোটের মিলে যাওয়া অংশ খুঁজে শুধু সেগুলোই আপনার AI-কে পাঠায়। উত্তরের প্রতিটি কথা যে নোট থেকে এসেছে সেখানে লিংক করা থাকে।"
          }
        }
      }
    },
    "Marrow keeps earlier versions of each note as you write, every few minutes, and thins them out over time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow keeps earlier versions of each note as you write, every few minutes, and thins them out over time."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেখার সময় ম্যারো প্রতি কয়েক মিনিটে প্রতিটি নোটের আগের সংস্করণ রাখে, আর সময়ের সাথে কমিয়ে আনে।"
          }
        }
      }
    },
    "Marrow keeps this file with your notes. Open it with an app that knows this kind of file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow keeps this file with your notes. Open it with an app that knows this kind of file."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যারো এই ফাইলটি আপনার নোটের সাথে রাখে। এ ধরনের ফাইল চেনে এমন অ্যাপে খুলুন।"
          }
        }
      }
    },
    "Marrow on a Mac can use the same folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow on a Mac can use the same folder."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-এর ম্যারোও একই ফোল্ডার ব্যবহার করতে পারে।"
          }
        }
      }
    },
    "Marrow syncs soon after each change, every 15 seconds while it's open, and when you come back to it. Notes changed in two places at once are merged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow syncs soon after each change, every 15 seconds while it's open, and when you come back to it. Notes changed in two places at once are merged."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি বদলের পরপরই, খোলা থাকলে প্রতি ১৫ সেকেন্ডে, আর অ্যাপে ফিরে এলে ম্যারো সিঙ্ক করে। দুই জায়গায় একসাথে বদলানো নোট একত্র করা হয়।"
          }
        }
      }
    },
    "Marrow works with the AI you choose. Your key stays on this phone, in its secure storage. Nothing is sent until you ask something.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marrow works with the AI you choose. Your key stays on this phone, in its secure storage. Nothing is sent until you ask something."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যারো আপনার বেছে নেওয়া AI-এর সাথে কাজ করে। আপনার কী এই ফোনের নিরাপদ স্টোরেজেই থাকে। আপনি কিছু না জিজ্ঞেস করা পর্যন্ত কিছুই পাঠানো হয় না।"
          }
        }
      }
    },
