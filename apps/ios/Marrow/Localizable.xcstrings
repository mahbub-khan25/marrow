    "Write - [ ] in any note to add a task. Add a date like 📅 2026-11-02 to see it here when it's due.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write - [ ] in any note to add a task. Add a date like 📅 2026-11-02 to see it here when it's due."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো নোটে - [ ] লিখে কাজ যোগ করুন। 📅 2026-11-02 এর মতো তারিখ দিলে সময়মতো এখানে দেখা যাবে।"
          }
        }
