{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Marrow Clipper",
  "description": "__MSG_description__",
  "version": "1.6.0",
  "default_locale": "en",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:53683/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" } }
  },
  "browser_specific_settings": {
    "gecko": { "id": "clipper@marrow.app", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
