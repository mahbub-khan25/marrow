{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marrow",
  "version": "1.3.0",
  "identifier": "app.marrow.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Khan",
    "copyright": "\u00a9 2026 Khan",
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes",
    "longDescription": "Marrow keeps your notes as plain Markdown files in a folder you choose, links them with [[wikilinks]], and shows backlinks, a graph and canvases.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "section": "text"
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "license": "MIT"
  }
}
