<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shows Marrow's notes folder in the Files app (On My iPhone/iPad › Marrow),
	     so notes stay plain files the person can see, copy and back up. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Quick capture: voice notes and photos, only when you tap the buttons. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Marrow records a voice note when you tap Voice note in Quick capture.</string>
	<key>NSCameraUsageDescription</key>
	<string>Marrow takes a photo for your note when you tap Photo in Quick capture.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Marrow adds the photos you pick to your note.</string>
</dict>
</plist>
